# source ~/xray/proxy.env 开启；source ~/xray/proxy.env off 关闭。
# 作用于当前终端后续运行的命令及其子进程。需 Bash 4.3 或更新版本。
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  printf '请使用 source %s [off]，bash 执行不能修改当前终端。\n' "$0" >&2
  exit 1
fi

_xray_terminal_main() {
  local IFS=$' \t\n'
  local root="${BASH_SOURCE[0]%/*}" mode="${1:-on}" name value flags decl
  local names=(HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NO_PROXY no_proxy
               PROXYCHAINS_CONF_FILE PROXYCHAINS_QUIET_MODE)
  [[ "$root" != "${BASH_SOURCE[0]}" ]] || root=.
  root="$(cd -- "$root" && pwd -P)" || return 1
  case "$mode" in on|off) ;; *) printf '用法: source %s [off]\n' "${BASH_SOURCE[0]}" >&2; return 1 ;; esac
  # 先检查可写性，避免只修改了一半环境却报告成功。
  for name in LD_PRELOAD "${names[@]}"; do
    decl="$(declare -p "$name" 2>/dev/null)" || continue
    flags="${decl#declare -}"; flags="${flags%% *}"
    if [[ "${flags//[x-]/}" != "" ]]; then
      printf '无法切换代理：变量 %s 必须是可写的普通字符串，不能带整数、大小写转换、只读、数组或引用属性。\n' "$name" >&2
      return 1
    fi
  done
  source "${root}/scripts/terminal-env.sh" || return 1
  if [[ -n "${_XRAY_PROXY_ROOT:-}" && "$_XRAY_PROXY_ROOT" != "$root" ]]; then
    printf '请先关闭 %s/proxy.env 的终端代理。\n' "$_XRAY_PROXY_ROOT" >&2
    return 1
  fi
  if [[ "$mode" == off ]]; then
    _xray_remove_preload "$root" || return 1
    if [[ "${_XRAY_PROXY_ROOT:-}" == "$root" ]]; then
      for name in "${names[@]}"; do
        # 旧版本快照没有 NO_PROXY/no_proxy 条目时，不删除用户原有变量。
        [[ -v _XRAY_PROXY_SAVED_SET[$name] ]] || continue
        if [[ "${_XRAY_PROXY_SAVED_SET[$name]:-0}" == 1 ]]; then
          printf -v "$name" '%s' "${_XRAY_PROXY_SAVED_VALUE[$name]}"
          if [[ "${_XRAY_PROXY_SAVED_EXPORT[$name]:-0}" == 1 ]]; then
            export "$name"
          else
            export -n "$name"
          fi
        else
          unset "$name"
        fi
      done
      local original_preloads=() current_preloads=()
      IFS=$' :\t' read -ra original_preloads <<< "$_XRAY_PROXY_PRELOAD_ORIGINAL"
      IFS=$' :\t' read -ra current_preloads <<< "${LD_PRELOAD:-}"
      if [[ "${original_preloads[*]}" == "${current_preloads[*]}" ]]; then
        if [[ "$_XRAY_PROXY_PRELOAD_SET" == 1 ]]; then
          LD_PRELOAD="$_XRAY_PROXY_PRELOAD_ORIGINAL"
          if [[ "$_XRAY_PROXY_PRELOAD_EXPORTED" == 1 ]]; then
            export LD_PRELOAD
          else
            export -n LD_PRELOAD
          fi
        else
          unset LD_PRELOAD
        fi
      fi
      unset _XRAY_PROXY_ROOT _XRAY_PROXY_SAVED_SET _XRAY_PROXY_SAVED_VALUE _XRAY_PROXY_SAVED_EXPORT
      unset _XRAY_PROXY_PRELOAD_ORIGINAL _XRAY_PROXY_PRELOAD_EXPORTED _XRAY_PROXY_PRELOAD_SET
    fi
    printf '%s\n' '当前终端已取消本项目的代理注入。代理监听不受影响；原有代理变量已恢复（如有保存）。'
    return 0
  fi
  [[ -r "${root}/lib/libproxychains4.so" ]] || {
    printf '未找到库文件: %s/lib/libproxychains4.so\n' "$root" >&2; return 1;
  }
  # 配置生成在干净的子环境进行；失败时不改变当前终端。
  local PROXY_PORT checked_ports
  checked_ports="$( _xray_remove_preload "$root" && bash "${root}/xray.sh" __write_proxychains )" || return 1
  IFS=' ' read -r PROXY_PORT <<< "$checked_ports"
  # 重复启用时保留第一次启用前的快照，不把已注入的环境保存成原环境。
  if [[ -z "${_XRAY_PROXY_ROOT:-}" ]]; then
    _XRAY_PROXY_PRELOAD_ORIGINAL="$( _xray_remove_preload "$root"; printf '%s' "${LD_PRELOAD:-}" )"
    _XRAY_PROXY_PRELOAD_SET=0
    if [[ -v LD_PRELOAD && ( -n "$_XRAY_PROXY_PRELOAD_ORIGINAL" || -z "$LD_PRELOAD" ) ]]; then
      _XRAY_PROXY_PRELOAD_SET=1
    fi
    decl="$(declare -p LD_PRELOAD 2>/dev/null)" || decl=''
    flags="${decl#declare -}"; flags="${flags%% *}"
    _XRAY_PROXY_PRELOAD_EXPORTED=0
    [[ "$flags" != *x* ]] || _XRAY_PROXY_PRELOAD_EXPORTED=1
    declare -gA _XRAY_PROXY_SAVED_SET=() _XRAY_PROXY_SAVED_VALUE=() _XRAY_PROXY_SAVED_EXPORT=()
  fi
  for name in "${names[@]}"; do
    [[ -v _XRAY_PROXY_SAVED_SET[$name] ]] && continue
    _XRAY_PROXY_SAVED_SET[$name]=0
    _XRAY_PROXY_SAVED_EXPORT[$name]=0
    _XRAY_PROXY_SAVED_VALUE[$name]=''
    # 子 Bash 只继承注入后的环境；不能把本项目的配置误认为用户原有配置。
    if [[ "$name" == PROXYCHAINS_* && ( "${PROXYCHAINS_CONF_FILE:-}" == "${root}/runtime/proxychains.conf" || "${PROXYCHAINS_CONF_FILE:-}" == "${root}/tmp/proxychains.conf" ) ]]; then
      continue
    fi
    if [[ -v "$name" ]]; then
      _XRAY_PROXY_SAVED_SET[$name]=1
      _XRAY_PROXY_SAVED_VALUE[$name]="${!name}"
      decl="$(declare -p "$name")"
      flags="${decl#declare -}"; flags="${flags%% *}"
      [[ "$flags" != *x* ]] || _XRAY_PROXY_SAVED_EXPORT[$name]=1
    fi
  done
  _XRAY_PROXY_ROOT="$root"
  _xray_remove_preload "$root" || return 1
  export PROXYCHAINS_CONF_FILE="${root}/runtime/proxychains.conf" PROXYCHAINS_QUIET_MODE=1
  export LD_PRELOAD="${root}/lib/libproxychains4.so${LD_PRELOAD:+:${LD_PRELOAD}}"
  export http_proxy="http://127.0.0.1:${PROXY_PORT}" HTTP_PROXY="http://127.0.0.1:${PROXY_PORT}"
  export https_proxy="$http_proxy" HTTPS_PROXY="$http_proxy"
  export all_proxy="socks5h://127.0.0.1:${PROXY_PORT}" ALL_PROXY="socks5h://127.0.0.1:${PROXY_PORT}"
  # 两种大小写合并，保持已有例外；ProxyChains 只单独放行本机回环。
  local bypass="localhost,127.0.0.1,::1" item previous
  previous="${_XRAY_PROXY_SAVED_VALUE[no_proxy]:-},${_XRAY_PROXY_SAVED_VALUE[NO_PROXY]:-}"
  local bypass_items=()
  IFS=',' read -ra bypass_items <<< "$previous"
  for item in "${bypass_items[@]}"; do
    [[ -z "$item" || ",$bypass," == *",$item,"* ]] || bypass+=",$item"
  done
  export no_proxy="$bypass" NO_PROXY="$bypass"
  printf '当前终端已配置 SOCKS / HTTP 混合代理 127.0.0.1:%s 及 ProxyChains。测试：bash %s/xray.sh test；关闭：source %s/proxy.env off\n' "$PROXY_PORT" "$root" "$root"
}

if _xray_terminal_main "$@"; then
  unset -f _xray_terminal_main _xray_remove_preload _xray_load_ports _xray_ensure_ports _xray_check_running_ports _xray_check_available_ports _xray_check_ports
  return 0
else
  unset -f _xray_terminal_main _xray_remove_preload _xray_load_ports _xray_ensure_ports _xray_check_running_ports _xray_check_available_ports _xray_check_ports
  return 1
fi
